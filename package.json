{
  "name": "hypatia",
  "version": "0.3.1",
  "description": "A living team wiki for any git repo: a map of how the code connects and who is working on what, kept current by your coding agent.",
  "keywords": [
    "wiki",
    "team-wiki",
    "docs",
    "documentation",
    "knowledge-graph",
    "knowledge-base",
    "obsidian",
    "graph",
    "markdown",
    "github-pages",
    "git",
    "team",
    "onboarding",
    "developer-tools",
    "cli",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "llms-txt"
  ],
  "author": "Max Hawksby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxhawksby/hypatia.git"
  },
  "homepage": "https://maxhawksby.github.io/hypatia/",
  "bugs": {
    "url": "https://github.com/maxhawksby/hypatia/issues"
  },
  "bin": {
    "hypatia": "bin/hypatia.js"
  },
  "files": [
    "bin",
    "lib",
    "site",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "wiki": "node bin/hypatia.js serve"
  },
  "publishConfig": {
    "access": "public"
  }
}
